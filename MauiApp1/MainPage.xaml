<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             BackgroundColor="Black">
    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScreenTapped" NumberOfTapsRequired="1"/>
            <TapGestureRecognizer Tapped="OnDoubleTapped" NumberOfTapsRequired="2" />
        </Grid.GestureRecognizers>

        <StackLayout x:Name="Layout" VerticalOptions="Center" HorizontalOptions="Center">
        <Label x:Name="TimerLabel"
               Text="00:00:00"
               TextColor="White"
               FontSize="48"
               FontFamily="RobotoMonoRegular"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        <Label x:Name="ColorToneLabel"
               Text=""
               FontSize="36"
               FontFamily="RobotoMonoRegular"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </StackLayout>
    </Grid>
</ContentPage>
